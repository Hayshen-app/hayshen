# Copy to .env and adjust. CRA only exposes vars prefixed REACT_APP_ —
# other prefixes (e.g. NEXT_PUBLIC_*, used by the mobile apps) are silently
# ignored here.

# Base URL of hayshen-backend, including /api/v1. Falls back to
# http://localhost:8080/api/v1 in src/api/client.ts if unset.
REACT_APP_API_BASE_URL=http://localhost:8080/api/v1

# Optional: only needed if a component starts using Google Maps directly.
GOOGLE_MAPS_API_KEY=
